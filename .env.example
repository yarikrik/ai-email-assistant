# Пошта (Gmail: увімкніть IMAP і створіть пароль застосунку)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASSWORD=app-password
IMAP_FOLDER=INBOX
# Папка чернеток визначається автоматично (\Drafts). Вкажіть, лише якщо не спрацювало
DRAFTS_FOLDER=
# Ім'я відправника в чернетках
FROM_NAME=Служба підтримки «Затишна Хата»

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite

# Telegram-сповіщення менеджеру
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets журнал (необов'язково; CSV-журнал ведеться завжди)
SHEET_ID=
GOOGLE_CREDENTIALS=data/credentials.json

# Правила
POLL_INTERVAL=60
MIN_CONFIDENCE=0.7
# Листи старші за N днів при першому запуску не обробляємо
LOOKBACK_DAYS=3
KNOWLEDGE_FILE=knowledge.md
DATA_DIR=data
